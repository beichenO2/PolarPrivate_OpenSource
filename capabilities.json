{
  "project": "PolarPrivate",
  "version": "0.6.0",
  "capabilities": [
    {
      "id": "polarprivate.llm.chat",
      "service_name": "polarprivate",
      "description": "OpenAI 兼容统一 LLM 网关；按 QCSA 能力码或模型别名路由，并在进程内注入已绑定凭证",
      "transport": "http",
      "endpoint": "/v1/chat/completions",
      "method": "POST",
      "idempotent": false,
      "side_effects": false,
      "timeout_ms": 300000
    },
    {
      "id": "polarprivate.llm.embeddings",
      "service_name": "polarprivate",
      "description": "OpenAI 兼容 Embeddings 网关；使用 E000 能力码路由到已配置的嵌入服务",
      "transport": "http",
      "endpoint": "/v1/embeddings",
      "method": "POST",
      "idempotent": false,
      "side_effects": false,
      "timeout_ms": 300000
    },
    {
      "id": "polarprivate.llm.models",
      "service_name": "polarprivate",
      "description": "列出 Vault 解锁后当前可用的 OpenAI 兼容模型目录",
      "transport": "http",
      "endpoint": "/v1/models",
      "method": "GET",
      "idempotent": true,
      "side_effects": false,
      "timeout_ms": 10000
    },
    {
      "id": "polarprivate.proxy",
      "service_name": "polarprivate",
      "description": "反向代理到已绑定的上游服务（LLM API 等），自动注入密钥",
      "transport": "http",
      "endpoint": "/proxy/{service_name}/{path}",
      "method": "POST",
      "input_schema": {
        "type": "object",
        "properties": {
          "service_name": { "type": "string", "description": "绑定的服务名（如 openai, anthropic）" },
          "path": { "type": "string", "description": "上游路径" }
        }
      },
      "idempotent": false,
      "side_effects": false,
      "timeout_ms": 120000
    },
    {
      "id": "polarprivate.render",
      "service_name": "polarprivate",
      "description": "将 binding/secret_ref 占位符渲染为不含明文的引用标记",
      "transport": "http",
      "endpoint": "/api/render",
      "method": "POST",
      "input_schema": {
        "type": "object",
        "required": ["template"],
        "properties": {
          "template": { "type": "string" },
          "format": { "type": "string", "enum": ["markdown", "html", "txt"] },
          "project_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "rendered": { "type": "string" },
          "warnings": { "type": "array" },
          "stats": { "type": "object" }
        }
      },
      "idempotent": true,
      "side_effects": false,
      "timeout_ms": 10000
    },
    {
      "id": "polarprivate.sanitize.scan",
      "service_name": "polarprivate",
      "description": "扫描文本中的敏感信息",
      "transport": "http",
      "endpoint": "/api/sanitize/scan",
      "method": "POST",
      "idempotent": true,
      "side_effects": false,
      "timeout_ms": 15000
    },
    {
      "id": "polarprivate.sanitize.redact",
      "service_name": "polarprivate",
      "description": "脱敏文本中的敏感信息",
      "transport": "http",
      "endpoint": "/api/sanitize/redact",
      "method": "POST",
      "idempotent": true,
      "side_effects": false,
      "timeout_ms": 15000
    },
    {
      "id": "polarprivate.vault.status",
      "service_name": "polarprivate",
      "description": "检查 Vault 锁定状态",
      "transport": "http",
      "endpoint": "/api/vault/status",
      "method": "GET",
      "idempotent": true,
      "side_effects": false,
      "timeout_ms": 3000
    },
    {
      "id": "polarprivate.export",
      "service_name": "polarprivate",
      "description": "导出仅含 Binding/Secret 引用标记的项目配置文件（markdown/html/txt）",
      "transport": "http",
      "endpoint": "/api/export",
      "method": "POST",
      "idempotent": true,
      "side_effects": false,
      "timeout_ms": 10000
    }
  ]
}
